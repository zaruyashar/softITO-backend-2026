@model IEnumerable<bridge_mvc_project.Models.Developer>

@{
    ViewData["Title"] = "Index";
}

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.DeveloperId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeveloperName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FoundationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DeveloperValue)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.DeveloperId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DeveloperName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FoundationDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DeveloperValue)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DeveloperId" class="btn btn-primary">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.DeveloperId" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>