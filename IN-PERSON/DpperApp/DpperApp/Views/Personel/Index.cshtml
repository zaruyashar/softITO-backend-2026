@model IEnumerable<DpperApp.Models.PersonelModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="EY">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PersonelNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AdSoyadi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Adres)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PersonelNo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AdSoyadi)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Yas)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Telefon)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Adres)
                </td>
                <td>
                    @Html.ActionLink("Edit", "EY", new { id = item.PersonelNo }, new { @class = "btn btn-success" }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.PersonelNo }, new { @class = "btn btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>